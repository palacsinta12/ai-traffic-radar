# Python machine learning project deployment hygiene
# General Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.env
.venv/
venv/
env/
.ipynb_checkpoints/

# Virtual environment and tooling
.DS_Store
.idea/
.vscode/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# NDA-sensitive data directories and project execution artifacts
/measurements/
/dataset/
/runs/
/assets/
/deliverables/
/crossing_data/
/docs/
!assets/**/*.gif
!assets/**/*.png
!assets/*.gif
!assets/*.png

# Model weights and inference artifacts
*.pt
*.onnx

# Standard generated media and archives
*.mp4
*.avi
*.mov
*.zip
*.tar.gz
*.xlsx

# Jupyter
.ipynb_checkpoints/

# Keep selected ONNX artifacts explicitly allowed in git by adding a line like:
# !path/to/explicitly_allowed.onnx

